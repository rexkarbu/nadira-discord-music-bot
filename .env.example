# ==============================================================================
# Iwed Discord Music Bot — Environment Variables Configuration
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan kredensial Anda.
# ==============================================================================

# --- Kredensial Discord (Wajib) ---
# Token autentikasi bot Discord dari Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Client ID / Application ID bot Discord
DISCORD_APPLICATION_ID=123456789012345678

# --- Guild Development (Opsional) ---
# Server ID Discord untuk instant slash command sync saat development
# DISCORD_TEST_GUILD_ID=123456789012345678

# --- Kredensial & Endpoint Lavalink v4 ---
# URI Lavalink REST endpoint (Gunakan http://localhost:2333 untuk lokal, http://lavalink:2333 di container)
LAVALINK_URI=http://localhost:2333

# Password node Lavalink (harus cocok dengan lavalink/application.yml)
LAVALINK_PASSWORD=youshallnotpass

# --- Observabilitas & Logging ---
# Level logging sistem: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# Reserved Configurations (Fase 2+)
# Pengaturan di bawah ini disiapkan untuk fase mendatang dan tidak aktif di Fase 1.
# ==============================================================================
SOURCE_POLICY_MODE=prototype
QUEUE_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379/0
MAX_PLAYLIST_TRACKS=500
QUEUE_MAX_TRACKS=1000
IDLE_DISCONNECT_SECONDS=300
DEFAULT_VOLUME=70
