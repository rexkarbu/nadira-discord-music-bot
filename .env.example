# ==============================================================================
# DISCORD MUSIC BOT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi .env lalu isi nilai-nilai kredensial yang sesuai.
# JANGAN PERNAH meng-commit file .env yang berisi token atau rahasia ke Git!
# ==============================================================================

# --- Discord Bot Credentials ---
# Token bot Discord dari Discord Developer Portal (Wajib)
DISCORD_TOKEN=your_discord_bot_token_here

# Application ID / Client ID dari Discord Developer Portal (Wajib)
DISCORD_APPLICATION_ID=123456789012345678

# Guild ID server Discord khusus untuk sinkronisasi slash commands saat development (Wajib)
DISCORD_TEST_GUILD_ID=123456789012345678

# --- Lavalink Audio Node ---
# URI/URL endpoint REST & WebSocket Lavalink v4
# Gunakan http://localhost:2333 untuk development lokal di Windows, atau http://lavalink:2333 di dalam Docker network
LAVALINK_URI=http://localhost:2333

# Password node Lavalink (wajib disesuaikan dengan konfigurasi server Lavalink)
LAVALINK_PASSWORD=youshallnotpass

# --- Policy & Queue Mode ---
# Mode kebijakan sumber: 'prototype' (default untuk test guild) atau 'compliance-first'
SOURCE_POLICY_MODE=prototype

# Backend antrean: 'memory' (in-memory, default Fase 1) atau 'redis' (fase masa depan)
QUEUE_BACKEND=memory

# URL koneksi Redis (Hanya wajib jika QUEUE_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# --- Audio & Queue Invariants ---
# Batas maksimum lagu yang dapat diimpor dari satu playlist (1 - 5000)
MAX_PLAYLIST_TRACKS=500

# Batas kapasitas maksimum antrean per guild (1 - 10000)
QUEUE_MAX_TRACKS=1000

# Waktu tunggu (dalam detik) sebelum bot keluar dari voice channel saat idle (10 - 86400)
IDLE_DISCONNECT_SECONDS=300

# Volume default saat pemutaran lagu dimulai (0 - 100)
DEFAULT_VOLUME=70

# --- Observability ---
# Level logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
